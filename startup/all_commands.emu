# Стартовый скрипт со всеми командами и режимами этапов 1 и 2
# Строки, начинающиеся с #, и пустые строки пропускаются

# ls: без аргументов и с аргументами
ls
ls -l
ls -a /tmp

# cd: переменные окружения $VAR и ${VAR}
cd /home
cd $EMU_DEMO_DIR
cd ${EMU_DEMO_DIR}/sub

# Ошибки: неизвестная команда и неверные аргументы
foo
cd one two
exit now

# exit завершает работу, строки ниже не выполняются
exit
ls
